      <xs:enumeration value="Ts"/>  <!-- 117 -->
      <xs:enumeration value="Og"/>  <!-- 118 -->
    </xs:restriction>
  </xs:simpleType>

  <!-- Energy in keV (positive decimal) -->
  <xs:simpleType name="EnergyType">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:maxInclusive value="20000"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Intensity (can exceed 1.0 for summed lines) -->
  <xs:simpleType name="IntensityType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Half-life with unit suffix -->
  <xs:simpleType name="HalfLifeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]+\.?[0-9]*(s|m|h|d|y|ms|us|ns)"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Emission line types -->
  <xs:simpleType name="LineTypeEnum">
    <xs:restriction base="xs:string">
      <!-- Gamma rays -->
      <xs:enumeration value="G"/>      <!-- Generic gamma -->
      <xs:enumeration value="P"/>      <!-- Photopeak gamma -->
      
      <!-- X-rays (K-shell) -->
      <xs:enumeration value="XKa1"/>
      <xs:enumeration value="XKa2"/>
      <xs:enumeration value="XKa3"/>
      <xs:enumeration value="XKb1"/>
      <xs:enumeration value="XKb2"/>
      <xs:enumeration value="XKb3"/>
      <xs:enumeration value="XKb4"/>
      <xs:enumeration value="XKb5"/>
      
      <!-- X-rays (L-shell) -->
      <xs:enumeration value="XLa1"/>
      <xs:enumeration value="XLa2"/>
      <xs:enumeration value="XLb1"/>
      <xs:enumeration value="XLb2"/>
      <xs:enumeration value="XLb3"/>
      <xs:enumeration value="XLb4"/>
      <xs:enumeration value="XLb6"/>
      <xs:enumeration value="XLg1"/>
      <xs:enumeration value="XLg2"/>
      <xs:enumeration value="XLg3"/>
      <xs:enumeration value="XLl"/>
      <xs:enumeration value="XLh"/>
      
      <!-- Annihilation -->
      <xs:enumeration value="A"/>      <!-- 511 keV annihilation -->
      
      <!-- Sum peaks -->
      <xs:enumeration value="S"/>      <!-- Sum peak -->
      
      <!-- Escape peaks -->
      <xs:enumeration value="SE"/>     <!-- Single escape -->
      <xs:enumeration value="DE"/>     <!-- Double escape -->
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
