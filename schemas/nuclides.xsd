<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <xs:annotation>
    <xs:documentation>
      ROBFIT Nuclide Library Schema
      
      Defines the structure for the nuclide emission line library.
      Contains gamma-ray and X-ray energies and intensities for
      isotopes used in template fitting for nuclide identification
      and quantification.
      
      Replaces individual .pgs files with a single nuclides.xml file.
    </xs:documentation>
  </xs:annotation>

  <!-- Root element -->
  <xs:element name="Nuclides" type="NuclidesType"/>

  <!-- Nuclides container -->
  <xs:complexType name="NuclidesType">
    <xs:sequence>
      <xs:element name="Nuclide" type="NuclideType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="Source" type="SourceType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    
    <!-- Library version -->
    <xs:attribute name="Version" type="xs:string" use="optional"/>
    
    <!-- Primary data source -->
    <xs:attribute name="DataSource" type="xs:string" use="optional"/>
    
    <!-- Date library was generated/updated -->
    <xs:attribute name="Date" type="xs:date" use="optional"/>
  </xs:complexType>
  
  <!-- Non-nuclide emission sources (annihilation, cosmic rays, backgrounds) -->
  <xs:complexType name="SourceType">
    <xs:sequence>
      <xs:element name="Line" type="LineType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    
    <!-- Source identifier -->
    <xs:attribute name="Name" type="xs:string" use="required"/>
    
    <!-- Description of the source -->
    <xs:attribute name="Description" type="xs:string" use="optional"/>
  </xs:complexType>

  <!-- Individual nuclide entry -->
  <xs:complexType name="NuclideType">
    <xs:sequence>
      <xs:element name="Line" type="LineType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    
    <!-- Element symbol (validated against periodic table) -->
    <xs:attribute name="Element" type="ElementType" use="required"/>
    
    <!-- Mass number -->
    <xs:attribute name="A" type="MassNumberType" use="required"/>
    
    <!-- Metastable state indicator -->
    <xs:attribute name="Isomer" type="xs:boolean" default="false"/>
    
    <!-- Half-life with unit -->
    <xs:attribute name="HalfLife" type="HalfLifeType" use="optional"/>
    
    <!-- Reference to data source if different from library default -->
    <xs:attribute name="Source" type="xs:string" use="optional"/>
  </xs:complexType>
  
  <!-- Mass number (1-300 covers all known isotopes) -->
  <xs:simpleType name="MassNumberType">
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="300"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Emission line -->
  <xs:complexType name="LineType">
    <!-- Energy in keV -->
    <xs:attribute name="E" type="EnergyType" use="required"/>
    
    <!-- Intensity (probability per decay) -->
    <xs:attribute name="I" type="IntensityType" use="required"/>
    
    <!-- Line type: gamma, X-ray, annihilation, etc. -->
    <xs:attribute name="Type" type="LineTypeEnum" use="required"/>
    
    <!-- Originating nuclide if different from parent (e.g., decay daughters) -->
    <xs:attribute name="Origin" type="xs:string" use="optional"/>
    
    <!-- Uncertainty in energy (keV) -->
    <xs:attribute name="dE" type="xs:decimal" use="optional"/>
    
    <!-- Uncertainty in intensity -->
    <xs:attribute name="dI" type="xs:decimal" use="optional"/>
  </xs:complexType>

  <!-- Element symbols (Z=1-118) -->
  <xs:simpleType name="ElementType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="H"/>   <!-- 1 -->
      <xs:enumeration value="He"/>  <!-- 2 -->
      <xs:enumeration value="Li"/>  <!-- 3 -->
      <xs:enumeration value="Be"/>  <!-- 4 -->
      <xs:enumeration value="B"/>   <!-- 5 -->
      <xs:enumeration value="C"/>   <!-- 6 -->
      <xs:enumeration value="N"/>   <!-- 7 -->
      <xs:enumeration value="O"/>   <!-- 8 -->
      <xs:enumeration value="F"/>   <!-- 9 -->
      <xs:enumeration value="Ne"/>  <!-- 10 -->
      <xs:enumeration value="Na"/>  <!-- 11 -->
      <xs:enumeration value="Mg"/>  <!-- 12 -->
      <xs:enumeration value="Al"/>  <!-- 13 -->
      <xs:enumeration value="Si"/>  <!-- 14 -->
      <xs:enumeration value="P"/>   <!-- 15 -->
      <xs:enumeration value="S"/>   <!-- 16 -->
      <xs:enumeration value="Cl"/>  <!-- 17 -->
      <xs:enumeration value="Ar"/>  <!-- 18 -->
      <xs:enumeration value="K"/>   <!-- 19 -->
      <xs:enumeration value="Ca"/>  <!-- 20 -->
      <xs:enumeration value="Sc"/>  <!-- 21 -->
      <xs:enumeration value="Ti"/>  <!-- 22 -->
      <xs:enumeration value="V"/>   <!-- 23 -->
      <xs:enumeration value="Cr"/>  <!-- 24 -->
      <xs:enumeration value="Mn"/>  <!-- 25 -->
      <xs:enumeration value="Fe"/>  <!-- 26 -->
      <xs:enumeration value="Co"/>  <!-- 27 -->
      <xs:enumeration value="Ni"/>  <!-- 28 -->
      <xs:enumeration value="Cu"/>  <!-- 29 -->
      <xs:enumeration value="Zn"/>  <!-- 30 -->
      <xs:enumeration value="Ga"/>  <!-- 31 -->
      <xs:enumeration value="Ge"/>  <!-- 32 -->
      <xs:enumeration value="As"/>  <!-- 33 -->
      <xs:enumeration value="Se"/>  <!-- 34 -->
      <xs:enumeration value="Br"/>  <!-- 35 -->
      <xs:enumeration value="Kr"/>  <!-- 36 -->
      <xs:enumeration value="Rb"/>  <!-- 37 -->
      <xs:enumeration value="Sr"/>  <!-- 38 -->
      <xs:enumeration value="Y"/>   <!-- 39 -->
      <xs:enumeration value="Zr"/>  <!-- 40 -->
      <xs:enumeration value="Nb"/>  <!-- 41 -->
      <xs:enumeration value="Mo"/>  <!-- 42 -->
      <xs:enumeration value="Tc"/>  <!-- 43 -->
      <xs:enumeration value="Ru"/>  <!-- 44 -->
      <xs:enumeration value="Rh"/>  <!-- 45 -->
      <xs:enumeration value="Pd"/>  <!-- 46 -->
      <xs:enumeration value="Ag"/>  <!-- 47 -->
      <xs:enumeration value="Cd"/>  <!-- 48 -->
      <xs:enumeration value="In"/>  <!-- 49 -->
      <xs:enumeration value="Sn"/>  <!-- 50 -->
      <xs:enumeration value="Sb"/>  <!-- 51 -->
      <xs:enumeration value="Te"/>  <!-- 52 -->
      <xs:enumeration value="I"/>   <!-- 53 -->
      <xs:enumeration value="Xe"/>  <!-- 54 -->
      <xs:enumeration value="Cs"/>  <!-- 55 -->
      <xs:enumeration value="Ba"/>  <!-- 56 -->
      <xs:enumeration value="La"/>  <!-- 57 -->
      <xs:enumeration value="Ce"/>  <!-- 58 -->
      <xs:enumeration value="Pr"/>  <!-- 59 -->
      <xs:enumeration value="Nd"/>  <!-- 60 -->
      <xs:enumeration value="Pm"/>  <!-- 61 -->
      <xs:enumeration value="Sm"/>  <!-- 62 -->
      <xs:enumeration value="Eu"/>  <!-- 63 -->
      <xs:enumeration value="Gd"/>  <!-- 64 -->
      <xs:enumeration value="Tb"/>  <!-- 65 -->
      <xs:enumeration value="Dy"/>  <!-- 66 -->
      <xs:enumeration value="Ho"/>  <!-- 67 -->
      <xs:enumeration value="Er"/>  <!-- 68 -->
      <xs:enumeration value="Tm"/>  <!-- 69 -->
      <xs:enumeration value="Yb"/>  <!-- 70 -->
      <xs:enumeration value="Lu"/>  <!-- 71 -->
